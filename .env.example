# Copy to .env and fill in. Never commit .env.

# ---- core ----
APP_ENV=development
LOG_LEVEL=info

# ---- storage ----
# SQLite for the 7-day build. Swap to postgresql+psycopg://... later; the
# SQLAlchemy models are unchanged, only FTS5 search needs a Postgres equivalent.
DATABASE_URL=sqlite:///data/engine.db
DATA_DIR=data

# ---- ingestion ----
APIS_GURU_LIST_URL=https://api.apis.guru/v2/list.json
INGEST_SPEC_LIMIT=100
# Must exceed ~850 or GitHub's /repos endpoints get truncated away
INGEST_MAX_ENDPOINTS_PER_API=1200

# ---- LLM (Day 5) ----
# LLM_PROVIDER is "openai" or "gemini"
LLM_PROVIDER=gemini
LLM_API_KEY=
# openai: gpt-4o-mini   |   gemini: gemini-3.6-flash
LLM_MODEL=gemini-3.6-flash
# Embeddings run locally by default: the Gemini free tier allows only 1000
# embed requests per DAY, which cannot cover a 10k-endpoint corpus.
# EMBEDDING_PROVIDER: local | gemini | openai
EMBEDDING_PROVIDER=local
# local: BAAI/bge-small-en-v1.5 (384d) | gemini: gemini-embedding-001 | openai: text-embedding-3-small
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384
LLM_TIMEOUT_SECONDS=60
# Batch size and pacing for embedding generation (free tiers are per-minute)
EMBEDDING_BATCH_SIZE=50
EMBEDDING_REQUEST_DELAY_MS=2000
PLANNER_MAX_REPAIR_ITERATIONS=3

# ---- search ----
SEARCH_TOP_K=20
RRF_K=60
# Expand query verbs with synonyms (send -> post/create). Benchmarked on Day 3.
SEARCH_EXPAND_SYNONYMS=true

# ---- execution (Day 6) ----
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_BASE_MS=250
EXECUTION_ALLOWLIST_ONLY=true
SSRF_BLOCK_PRIVATE_RANGES=true
# Comma-separated provider ids permitted to actually execute
EXECUTION_ALLOWLIST=httpbin.org,slack.com,github.com

# ---- OAuth 2.0 (Google: Gmail, Calendar) ----
# Register an OAuth client at console.cloud.google.com, add the redirect URI
# below as an authorised redirect, then paste the pair here. The secret stays
# on the server; the browser never sees it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback

# ---- credentials ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# ---- dev-only provider credentials ----
DEV_SLACK_WEBHOOK_URL=
DEV_GITHUB_TOKEN=
